{% extends 'base.html.twig' %}

{% block title %}Pinboard{% endblock %}

{% block body %}
    <h1>Tous les pins</h1>

    <div class="pin-grid">
        {% for pin in pins %}
            <a href="{{ path('app_pin_show', {id: pin.id}) }}" class="pin-card">
                {% if pin.imageName %}
                    <img src="{{ vich_uploader_asset(pin, 'imageFile') }}" alt="{{ pin.title }}">
                {% endif %}
                <div class="pin-card-body">
                    <div class="pin-card-title">{{ pin.title|length > 30 ? pin.title|slice(0, 30) ~ '...' : pin.title }}</div>
                    <div class="pin-card-meta">{{ pin.createdAt|date('d/m/Y') }} · {{ pin.user.firstname }} {{ pin.user.lastname }}</div>
                </div>
            </a>
        {% else %}
            <p>Aucun pin pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}
