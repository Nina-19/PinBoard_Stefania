{% extends 'base.html.twig' %}

{% block title %}Créer un pin{% endblock %}

{% block body %}
    <section class="page-shell page-shell-form">
        <div class="form-shell">
            <h1 class="text-center mb-4">Créer un pin</h1>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
                {{ form_widget(form) }}
            {{ form_end(form) }}

            <a href="{{ path('app_home') }}" class="link-back">Retour</a>
        </div>
    </section>
{% endblock %}