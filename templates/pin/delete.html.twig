{% extends 'base.html.twig' %}

{% block title %}Supprimer {{ pin.title }}{% endblock %}

{% block body %}
    <h1>Supprimer le pin</h1>

    <p>Voulez-vous vraiment supprimer le pin "{{ pin.title }}" ?</p>

    <form method="post" action="{{ path('app_pin_delete', {id: pin.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pin.id) }}">
        <button type="submit">Confirmer la suppression</button>
    </form>

    <a href="{{ path('app_pin_show', {id: pin.id}) }}">Annuler</a>
{% endblock %}