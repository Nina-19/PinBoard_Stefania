{% extends 'base.html.twig' %}

{% block title %}Éditer {{ pin.title }}{% endblock %}

{% block body %}
    <div class="form-shell">
        <h1 class="text-center mb-4">Éditer le pin</h1>

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
            {{ form_widget(form) }}
        {{ form_end(form) }}

        <a href="{{ path('app_pin_show', {id: pin.id}) }}" class="d-block text-center mt-3">Retour</a>
    </div>
{% endblock %}
