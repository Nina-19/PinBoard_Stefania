{% extends 'base.html.twig' %}

{% block title %}{{ pin.title|length > 30 ? pin.title|slice(0, 30) ~ '...' : pin.title }}{% endblock %}

{% block body %}
    <h1>{{ pin.title }}</h1>

    {% if pin.imageName %}
        <img src="{{ vich_uploader_asset(pin, 'imageFile') }}" alt="{{ pin.title }}" style="max-width: 600px; width: 100%; height: auto;">
    {% endif %}

    <p>{{ pin.description }}</p>

    <p>Par {{ pin.user.firstname }} {{ pin.user.lastname }}</p>

    <p>Créé le {{ pin.createdAt|date('d/m/Y H:i') }}</p>
    <p>Modifié le {{ pin.updatedAt|date('d/m/Y H:i') }}</p>

    {% if app.user and pin.user == app.user %}
        <a href="{{ path('app_pin_edit', {id: pin.id}) }}">Éditer</a>
        <a href="{{ path('app_pin_delete', {id: pin.id}) }}">Supprimer</a>
    {% endif %}

    <a href="{{ path('app_pin_index') }}">Retour</a>
{% endblock %}
