{% extends 'base.html.twig' %}

{% block title %}Pinboard{% endblock %}

{% block body %}
    <h1>Tous les pins</h1>

    <a href="{{ path('app_pin_create') }}">Créer un pin</a>

    <div style="display:flex; flex-wrap:wrap; gap:20px;">
        {% for pin in pins %}
            <div style="width:220px; border:1px solid #ccc; padding:10px;">
                <a href="{{ path('app_pin_show', {id: pin.id}) }}">
                    {% if pin.imageName %}
                        <img src="{{ vich_uploader_asset(pin, 'imageFile') }}" alt="{{ pin.title }}" style="width:25px; height:25px; object-fit:cover; display:block;">
                    {% endif %}
                </a>

                <p>
                    <a href="{{ path('app_pin_show', {id: pin.id}) }}">
                        {{ pin.title|length > 30 ? pin.title|slice(0, 30) ~ '...' : pin.title }}
                    </a>
                </p>

                <p>Publié le {{ pin.createdAt|date('d/m/Y H:i') }}</p>
                <p>Par {{ pin.user.firstname }} {{ pin.user.lastname }}</p>
            </div>
        {% else %}
            <p>Aucun pin pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}
